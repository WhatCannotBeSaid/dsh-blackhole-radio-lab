{
  "name": "dsh-blackhole-radio-lab",
  "version": "1.2.0",
  "description": "A 3D black-hole radio stage for DeepSeek Harness: orbit, zoom and play 24,000+ internet radio stations",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.stage.js",
    "client.radio.js",
    "client.hls.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "LICENSE-BLACK_HOLE_SHADER",
    "THIRD-PARTY-NOTICES.md",
    "src",
    "data/catalog.v1.json",
    "data/catalog.v1.json.gz",
    "tools/build-stage.mjs",
    "tools/build-catalog.mjs"
  ],
  "scripts": {
    "build": "node tools/build-stage.mjs",
    "build:catalog": "node tools/build-catalog.mjs",
    "test": "node tools/test-transition.mjs && node --test tools/test-radio-resilience.mjs && node tools/test-radio-entry.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "radio",
    "internet-radio",
    "black-hole",
    "three-js",
    "webgl"
  ],
  "license": "MIT",
  "author": "WhatCannotBeSaid",
  "homepage": "https://github.com/WhatCannotBeSaid/dsh-blackhole-radio-lab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhatCannotBeSaid/dsh-blackhole-radio-lab.git"
  },
  "bugs": {
    "url": "https://github.com/WhatCannotBeSaid/dsh-blackhole-radio-lab/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "hls.js": "^1.7.4"
  }
}
